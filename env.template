# Llama Stack RAG Evaluation Configuration
# Copy this file to .env and edit with your values

# ============================================================================
# Llama Stack Configuration
# ============================================================================

LLAMA_STACK_URL=https://llama-stack-example-llama-stack-example.apps.
MODEL_ID=vllm-inference/llama-4-scout-17b-16e-w4a16
EMBEDDING_MODEL=granite-embedding-125m

# ============================================================================
# File Paths
# ============================================================================

DOCUMENTS_DIR=documents
INPUT_DATASET=dataset-base/millbrook_dataset.json
OUTPUT_DATASET=output/millbrook_ragas_dataset.json
RESULTS_FILE=output/millbrook_ragas_results.json

# ============================================================================
# Advanced Options
# ============================================================================

VERIFY_SSL=false

# ============================================================================
# Vector Store Configuration
# ============================================================================
# If you already have uploaded documents, specify the VECTOR_STORE_ID here
# The script will automatically skip step 1 (upload) if defined

# ✅ Vector Store created with granite-embedding-125m (compatible with server)
# Created: 2025-12-03 17:00
# This vector store uses the same embedding model as the server
VECTOR_STORE_ID=

# If you need to create a NEW vector store, leave this variable empty:
# VECTOR_STORE_ID=

# ============================================================================
# Usage
# ============================================================================

# 1. Copy this file: cp env.template .env
# 2. Edit .env with your values
# 3. Run the workflow: ./run_example.sh

